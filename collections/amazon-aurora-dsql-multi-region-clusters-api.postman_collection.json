                    },
                    "key": "Authorization",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"linkedRegionList\": [\n    \"us-east-1\",\n    \"us-west-2\"\n  ],\n  \"clusterProperties\": {\n    \"deletionProtectionEnabled\": true\n  },\n  \"witnessRegion\": \"eu-west-1\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"linkedClusterArns\": [\n    \"arn:aws:dsql:us-east-1:123456789012:cluster/cluster1\",\n    \"arn:aws:dsql:us-west-2:123456789012:cluster/cluster2\"\n  ]\n}",
              "cookie": [],
