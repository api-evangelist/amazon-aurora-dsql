          "name": "Amazon Aurora DSQL Create Multi Region Clusters",
          "request": {
            "name": "Amazon Aurora DSQL Create Multi Region Clusters",
            "description": {
              "content": "Creates multi-Region clusters in Amazon Aurora DSQL. Multi-Region clusters require a linked Region list, which is an array of the Regions in which you want to create linked clusters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "multi-region-clusters"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"linkedRegionList\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"clusterProperties\": {\n    \"deletionProtectionEnabled\": \"<boolean>\",\n    \"tags\": {\n      \"key_0\": \"<string>\",\n      \"key_1\": \"<string>\",\n      \"key_2\": \"<string>\",\n      \"key_3\": \"<string>\"\n    }\n  },\n  \"witnessRegion\": \"<string>\",\n  \"clientToken\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "f9e8223d-9e9a-4d83-a4c7-95c0fbffde5b",
              "name": "Multi-region clusters created successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "multi-region-clusters"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
